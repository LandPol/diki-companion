{
    "manifest_version": 3,
    "name": "Extention for Diki",
    "version": "1.2",
    "permissions": ["storage"],

    "background": {
        "service_worker": "background.js"
    },

    "icons": {
        "16": "logo/diki_logo16.png",
        "32": "logo/diki_logo32.png",
        "48": "logo/diki_logo48.png",
        "128": "logo/diki_logo128.png"
    },

    "action": {
        "default_popup": "popup/popup.html",
        "defualt_icon": {
            "16": "logo/diki_logo16.png",
            "32": "logo/diki_logo32.png"
        }
    },

    "content_scripts": [
        {
            "matches": ["https://www.diki.pl/*"],
            "css": [
                "dark.css",
                "ads.css"
            ],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],

    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}